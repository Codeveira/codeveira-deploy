# Copy to .env and fill in values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=your_secure_password
# Optional: full DATABASE_URL overrides individual DB_* vars
# DATABASE_URL=postgresql://codereview:your_secure_password@db:5432/codereview_production

# ── Rails ─────────────────────────────────────────────────────────────────────
# Generate with: rails secret
SECRET_KEY_BASE=
# Optional master key for encrypted credentials (config/credentials.yml.enc)
# Generate with: rails credentials:edit
RAILS_MASTER_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the application — used in email links and webhook hints
APP_HOST=https://codereview.example.com

# ── Initial admin account (used by db:seed) ───────────────────────────────────
# Change before running db:seed in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=codereview@example.com
SMTP_PASSWORD=smtp_password
# Sender address shown in outgoing emails
SMTP_FROM=codereview@example.com

# ── GitLab ────────────────────────────────────────────────────────────────────
# Base URL of your GitLab instance
GITLAB_URL=https://gitlab.example.com

# Personal access token with `api` scope — used for fetching commits and diffs
GITLAB_TOKEN=

# Secret token configured in the GitLab webhook; any random string
# REQUIRED — leave blank and all GitLab webhook requests will be rejected
# Generate with: openssl rand -hex 20
WEBHOOK_SECRET=

# OAuth application credentials (optional — enables "Sign in with GitLab")
# Create at: GitLab → Admin → Applications
# Redirect URI: https://<APP_HOST>/users/auth/gitlab/callback  Scopes: api, read_user
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with `repo` scope — used for fetching commits and diffs
GITHUB_TOKEN=

# Secret token configured in the GitHub webhook; any random string
# REQUIRED — leave blank and all GitHub webhook requests will be rejected
# Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=

# OAuth application credentials (optional — enables "Sign in with GitHub")
# Create at: GitHub → Settings → Developer settings → OAuth Apps
# Redirect URI: https://<APP_HOST>/users/auth/github/callback  Scopes: user:email, repo
GITHUB_APP_ID=
GITHUB_APP_SECRET=

# ── Gitea / Forgejo ───────────────────────────────────────────────────────────
# Default base URL of your Gitea or Forgejo instance.
# Can be overridden per-repository in the repository settings.
GITEA_URL=https://gitea.example.com

# Secret token configured in the Gitea/Forgejo webhook; any random string
# REQUIRED — leave blank and all Gitea/Forgejo webhook requests will be rejected
# Generate with: openssl rand -hex 20
GITEA_WEBHOOK_SECRET=

# ── Bitbucket Cloud ───────────────────────────────────────────────────────────
# Secret token configured in the Bitbucket Cloud webhook; any random string
# REQUIRED — leave blank and all Bitbucket Cloud webhook requests will be rejected
# Generate with: openssl rand -hex 20
BITBUCKET_WEBHOOK_SECRET=

# ── Bitbucket Server / Data Center ────────────────────────────────────────────
# Secret token configured in the Bitbucket Server webhook; any random string
# REQUIRED — leave blank and all Bitbucket Server webhook requests will be rejected
# Generate with: openssl rand -hex 20
BITBUCKET_SERVER_WEBHOOK_SECRET=

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# No webhook secret — Azure DevOps webhooks don't support HMAC signing.
# Restrict access at the network level if needed.

# ── Gerrit ────────────────────────────────────────────────────────────────────
# No webhook secret — use the Gerrit webhooks plugin; restrict at network level.

# ── LDAP (optional) ───────────────────────────────────────────────────────────
LDAP_HOST=your-ldap-server
LDAP_PORT=389
# Set to "true" to enable LDAPS
LDAP_SSL=false
LDAP_BASE=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_PASSWORD=ldap_admin_password
# Domain suffix used to construct email addresses when not provided by LDAP
LDAP_DOMAIN=example.com

# ── Production Rails flags ────────────────────────────────────────────────────
# Set to "true" to write logs to stdout (recommended in Docker)
RAILS_LOG_TO_STDOUT=true
# Set to "true" to let Rails serve static assets (needed if not behind nginx)
# RAILS_SERVE_STATIC_FILES=true

# ── IDE / LSP server ──────────────────────────────────────────────────────────
# TCP port for the global Codeveira LSP proxy.
# Developers connect from VS Code / JetBrains by setting codeveira.lspHost
# and codeveira.lspPort in their IDE settings — no local Node.js install needed.
# The LSP container is started automatically by docker compose.
# Change this only if port 7777 is already in use on your host.
LSP_PORT=7777

# ── Backup ────────────────────────────────────────────────────────────────────
# Directory inside the container where pg_dump backups are stored.
# Mapped to the backup_data Docker volume — do not change unless you remount elsewhere.
# BACKUP_DIR=/backups

# ── Demo / test mode ──────────────────────────────────────────────────────────
# Set to "true" to auto-seed realistic demo data on first boot (no repos must exist).
# Reset demo data: docker compose down -v && docker compose up -d
# TESTSERVICE=true
