# Copy to .env and fill in values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=your_secure_password
# Optional: full DATABASE_URL overrides individual DB_* vars
# DATABASE_URL=postgresql://codereview:your_secure_password@db:5432/codereview_production

# ── Rails ─────────────────────────────────────────────────────────────────────
# Generate with: rails secret
SECRET_KEY_BASE=
# Optional master key for encrypted credentials (config/credentials.yml.enc)
# Generate with: rails credentials:edit
RAILS_MASTER_KEY=

# Set to "true" once TLS is terminated in front of the app — the bundled
# `nginx` container already sends X-Forwarded-Proto: https once you've
# configured a domain in Settings → Domain & HTTPS. Redirects HTTP to HTTPS
# and marks cookies Secure. Leave unset while still on the container's
# default self-signed certificate, or if you reach the app directly over
# HTTP without any TLS-terminating proxy in front of it.
FORCE_SSL=true

# ── Encryption at rest (REQUIRED) ─────────────────────────────────────────────
# Encrypts Repository access tokens, AI provider API keys, user API tokens,
# and settings like the CI webhook token. The app will not boot without these.
# Generate all three at once with: docker compose run --rm app rails db:encryption:init
# (prints "primary_key: xxx / deterministic_key: xxx / key_derivation_salt: xxx"
# — copy just the value after each colon into the vars below)
# or generate individually with: openssl rand -hex 32 (each value must differ)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the application — used in email links and webhook hints
APP_HOST=https://codereview.example.com

# ── Initial admin account (used by db:seed) ───────────────────────────────────
# Change before running db:seed in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=codereview@example.com
SMTP_PASSWORD=smtp_password
# Sender address shown in outgoing emails
SMTP_FROM=codereview@example.com

# ── GitLab ────────────────────────────────────────────────────────────────────
# Base URL of your GitLab instance
GITLAB_URL=https://gitlab.example.com

# Personal access token with `api` scope — used for fetching commits and diffs
GITLAB_TOKEN=

# Secret token configured in the GitLab webhook; any random string
# REQUIRED — leave blank and all GitLab webhook requests will be rejected
# Generate with: openssl rand -hex 20
WEBHOOK_SECRET=

# OAuth application credentials (optional — enables "Sign in with GitLab")
# Create at: GitLab → Admin → Applications
# Redirect URI: https://<APP_HOST>/users/auth/gitlab/callback  Scopes: api, read_user
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with `repo` scope — used for fetching commits and diffs
GITHUB_TOKEN=

# Secret token configured in the GitHub webhook; any random string
# REQUIRED — leave blank and all GitHub webhook requests will be rejected
# Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=

# OAuth application credentials (optional — enables "Sign in with GitHub")
# Create at: GitHub → Settings → Developer settings → OAuth Apps
# Redirect URI: https://<APP_HOST>/users/auth/github/callback  Scopes: user:email, repo
GITHUB_APP_ID=
GITHUB_APP_SECRET=

# ── Gitea / Forgejo ───────────────────────────────────────────────────────────
# Default base URL of your Gitea or Forgejo instance.
# Can be overridden per-repository in the repository settings.
GITEA_URL=https://gitea.example.com

# Secret token configured in the Gitea/Forgejo webhook; any random string
# REQUIRED — leave blank and all Gitea/Forgejo webhook requests will be rejected
# Generate with: openssl rand -hex 20
GITEA_WEBHOOK_SECRET=

# ── Bitbucket Cloud ───────────────────────────────────────────────────────────
# Secret token configured in the Bitbucket Cloud webhook; any random string
# REQUIRED — leave blank and all Bitbucket Cloud webhook requests will be rejected
# Generate with: openssl rand -hex 20
BITBUCKET_WEBHOOK_SECRET=

# ── Bitbucket Server / Data Center ────────────────────────────────────────────
# Secret token configured in the Bitbucket Server webhook; any random string
# REQUIRED — leave blank and all Bitbucket Server webhook requests will be rejected
# Generate with: openssl rand -hex 20
BITBUCKET_SERVER_WEBHOOK_SECRET=

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# Azure DevOps Service Hooks don't support HMAC signing, so this is checked via
# HTTP Basic Authentication instead — set this same value as the password on
# the Web Hooks subscription in Azure DevOps (any username works).
# REQUIRED — leave blank and all Azure DevOps webhook requests will be rejected
# Generate with: openssl rand -hex 20
AZURE_WEBHOOK_SECRET=

# ── Gerrit ────────────────────────────────────────────────────────────────────
# The gerrit-webhooks plugin doesn't support HMAC signing either — same HTTP
# Basic Auth mechanism as Azure DevOps above. Configure it as the remote's
# password in the gerrit-webhooks plugin config (or inject Basic Auth at a
# reverse proxy in front of /webhooks/gerrit if your plugin version can't).
# REQUIRED — leave blank and all Gerrit webhook requests will be rejected
# Generate with: openssl rand -hex 20
GERRIT_WEBHOOK_SECRET=

# ── LDAP (optional) ───────────────────────────────────────────────────────────
LDAP_HOST=your-ldap-server
LDAP_PORT=389
# Set to "true" to enable LDAPS
LDAP_SSL=false
LDAP_BASE=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_PASSWORD=ldap_admin_password
# Domain suffix used to construct email addresses when not provided by LDAP
LDAP_DOMAIN=example.com

# ── Production Rails flags ────────────────────────────────────────────────────
# Set to "true" to write logs to stdout (recommended in Docker)
RAILS_LOG_TO_STDOUT=true
# Set to "true" to let Rails serve static assets (needed if not behind nginx)
# RAILS_SERVE_STATIC_FILES=true

# ── IDE / LSP server ──────────────────────────────────────────────────────────
# TCP port for the global Codeveira LSP proxy.
# Developers connect from VS Code / JetBrains by setting codeveira.lspHost
# and codeveira.lspPort in their IDE settings — no local Node.js install needed.
# The LSP container is started automatically by docker compose.
# Change this only if port 7777 is already in use on your host.
LSP_PORT=7777

# ── Symbol Indexer (Find Usages / Go to Declaration / Go to Symbol) ───────────
# Powers Standard+ tree-sitter symbol indexing (JS/TS, Ruby, Python, Go, Java,
# Kotlin, PHP). The indexer container has no exposed port — app and sidekiq
# reach it internally at http://indexer:8090.

# Shared secret required in the X-Indexer-Token header. Optional but strongly
# recommended — the indexer container logs a warning on startup if this is
# blank, since anything reachable on the Docker network could otherwise call
# it with no authentication.
SYMBOL_INDEXER_TOKEN=

# Memory/CPU limits for the indexer container. Raise if indexing large
# generated files fails, or if you have many active repositories pushing
# simultaneously. These limits are what keep a large indexing backlog from
# starving the rest of the stack.
INDEXER_MEM_LIMIT=768m
INDEXER_CPUS=1.0

# ── Backup ────────────────────────────────────────────────────────────────────
# Directory inside the container where pg_dump backups are stored.
# Mapped to the backup_data Docker volume — do not change unless you remount elsewhere.
# BACKUP_DIR=/backups

# Maximum accepted size (bytes) for a manually uploaded .dump file in
# Settings → Backup & Restore. Uploads are also checked for a valid pg_dump
# custom-format header before being accepted.
# MAX_BACKUP_UPLOAD_SIZE=2147483648

# ── Demo / test mode ──────────────────────────────────────────────────────────
# Set to "true" to auto-seed realistic demo data on first boot (no repos must exist).
# Reset demo data: docker compose down -v && docker compose up -d
# TESTSERVICE=true

# ── Monitoring (optional — docker-compose.monitoring.yml) ─────────────────────
# Only needed if you run the Prometheus + Grafana overlay:
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# See monitoring/prometheus_token.example for the /metrics scrape credential
# (a service account API token, not an env var — kept out of .env on purpose).
# GRAFANA_ADMIN_PASSWORD=change_me
