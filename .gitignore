# Secrets and local config
.env
/monitoring/prometheus_token

# Database backups written by DatabaseBackupJob
/backup/*
!/backup/.gitkeep

# Postgres/Redis data directories (bind-mounted, see docker-compose.yml).
# No .gitkeep here on purpose: Postgres' initdb refuses to initialize a data
# directory that contains any file at all, including a lone dotfile — a
# placeholder would break `docker compose up` on a fresh checkout. Docker
# auto-creates the host directory on first mount, which is all that's needed.
/pgdata/
/redis/

# `helm dependency update` build output when a subchart is fetched
# standalone (regenerated on demand, see helm/codeveira/README.md's
# "Standalone subcharts" section) -- one level deeper than
# helm/codeveira/charts/codeveira-common itself, which stays tracked.
helm/codeveira/charts/*/charts/
helm/codeveira/charts/*/Chart.lock
