# Docker Swarm deployment — env vars for docker-stack.yml
# Copy to .env and fill in values, then: source .env && ./deploy.sh
#
# This mirrors ../.env.example (the docker-compose.yml variant) plus a few
# vars that only make sense in a Swarm topology (CODEVEIRA_DATA_DIR,
# APP_REPLICAS, SIDEKIQ_REPLICAS, IMAGE_TAG). See ../.env.example for the
# full annotated reference of every application-level var (SMTP, OAuth,
# webhook secrets, LDAP, semantic-analysis tokens, etc.) — copy the values
# you need from your existing .env there. This file only documents what's
# new or different for the Swarm stack.

# ── Swarm-specific ──────────────────────────────────────────────────────────
# Absolute path on the primary node (see README.md) where persistent data
# lives: $CODEVEIRA_DATA_DIR/pgdata, /redis, /backup. Must be an absolute
# path — unlike docker-compose.yml, a stack file cannot resolve `./data`
# relative to this directory, and Swarm can schedule the primary-pinned
# services' tasks with a different implicit working directory.
CODEVEIRA_DATA_DIR=/srv/codeveira/data

# Image tag to deploy. Swarm re-resolves this against the registry on every
# `docker stack deploy` by default (no need for a `pull_policy: always`
# equivalent — that's a docker-compose-only key and isn't set here).
IMAGE_TAG=latest

# How many replicas of the stateless app/sidekiq services to run. Both are
# safe to scale horizontally (cookie sessions, Redis-backed ActionCable and
# Sidekiq queues — see "Scaling & High Availability" in ../README.md).
# Increasing these spreads load across whichever nodes Swarm schedules the
# tasks on, but does NOT provide failover for db/redis — see the "Not HA"
# section in README.md.
APP_REPLICAS=1
SIDEKIQ_REPLICAS=1

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=your_secure_password

# ── Rails ─────────────────────────────────────────────────────────────────────
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
FORCE_SSL=true

# ── Encryption at rest (REQUIRED) ─────────────────────────────────────────────
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=https://codereview.example.com

# ── Initial admin account (used by db:seed) ───────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=codereview@example.com
SMTP_PASSWORD=smtp_password
SMTP_FROM=codereview@example.com
INBOUND_EMAIL_DOMAIN=mail.example.com
RAILS_INBOUND_EMAIL_PASSWORD=

# ── VCS platform tokens / webhook secrets ─────────────────────────────────────
# See ../.env.example for the full list and generation instructions
# (GitLab/GitHub/Gitea/Bitbucket Cloud+Server/Azure DevOps/Gerrit/SVN).
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
WEBHOOK_SECRET=
GITLAB_APP_ID=
GITLAB_APP_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SECRET=
GITEA_URL=https://gitea.example.com
GITEA_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=
BITBUCKET_SERVER_WEBHOOK_SECRET=
AZURE_WEBHOOK_SECRET=
GERRIT_WEBHOOK_SECRET=
SVN_WEBHOOK_SECRET=

# ── LDAP (optional) ───────────────────────────────────────────────────────────
LDAP_HOST=your-ldap-server
LDAP_PORT=389
LDAP_SSL=false
LDAP_BASE=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_PASSWORD=ldap_admin_password
LDAP_DOMAIN=example.com

# ── Production Rails flags ────────────────────────────────────────────────────
RAILS_LOG_TO_STDOUT=true

# ── IDE / LSP server ──────────────────────────────────────────────────────────
LSP_PORT=7777
LSP_PROXY_SHARED_SECRET=

# ── Symbol Indexer ─────────────────────────────────────────────────────────────
SYMBOL_INDEXER_TOKEN=
INDEXER_MEM_LIMIT=768m
INDEXER_CPUS=1.0

# ── Lint Runner ─────────────────────────────────────────────────────────────────
LINT_RUNNER_TOKEN=
LINT_RUNNER_MEM_LIMIT=768m
LINT_RUNNER_CPUS=1.0

# ── Semantic Analysis (Enterprise) — Go/TS/Python/Java/Kotlin/PHP/C#/Ruby ──────
SEMANTIC_ANALYSIS_TOKEN=
SEMANTIC_ANALYSIS_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_CPUS=1.5
SEMANTIC_ANALYSIS_TS_TOKEN=
SEMANTIC_ANALYSIS_TS_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_TS_CPUS=1.5
SEMANTIC_ANALYSIS_PY_TOKEN=
SEMANTIC_ANALYSIS_PY_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_PY_CPUS=1.5
SEMANTIC_ANALYSIS_JAVA_TOKEN=
SEMANTIC_ANALYSIS_JAVA_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_JAVA_CPUS=1.5
SEMANTIC_ANALYSIS_KT_TOKEN=
SEMANTIC_ANALYSIS_KT_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_KT_CPUS=1.5
SEMANTIC_ANALYSIS_PHP_TOKEN=
SEMANTIC_ANALYSIS_PHP_MEM_LIMIT=1024m
SEMANTIC_ANALYSIS_PHP_CPUS=1.0
SEMANTIC_ANALYSIS_CSHARP_TOKEN=
SEMANTIC_ANALYSIS_CSHARP_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_CSHARP_CPUS=1.5
SEMANTIC_ANALYSIS_RUBY_TOKEN=
SEMANTIC_ANALYSIS_RUBY_MEM_LIMIT=1536m
SEMANTIC_ANALYSIS_RUBY_CPUS=1.5
