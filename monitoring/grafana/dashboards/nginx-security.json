{
  "id": null,
  "uid": "codeveira-nginx-security",
  "title": "Nginx — Connections & Security",
  "description": "Who's connecting to Codeveira and from where, plus failed/suspicious requests by IP — sourced from nginx's access log via Loki/Promtail (client IP is unbounded-cardinality data, so it lives in logs, not Prometheus labels).",
  "tags": ["codeveira", "nginx", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests (visible range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"nginx\"}[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Distinct Source IPs (visible range)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "count(count by (remote_addr) (count_over_time({job=\"nginx\"}[$__range])))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "4xx/5xx (visible range)",
      "description": "Errors and rejections — 401/403/404/429/5xx. A sudden spike from one IP is the classic scan/brute-force signature.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"nginx\", status=~\"4..|5..\"}[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed Sign-ins (visible range)",
      "description": "Non-2xx responses to /users/sign_in — repeated hits from one IP suggest a credential-stuffing/brute-force attempt (Devise's own lockout kicks in after too many, but this is what that attempt looks like from the outside).",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "sum(count_over_time(({job=\"nginx\"} | path=\"/users/sign_in\" | status!~\"2..|3..\")[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests by Status Class",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "sum by (status) (count_over_time({job=\"nginx\"}[$__auto]))", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    },

    {
      "id": 20,
      "type": "table",
      "title": "Top Source IPs",
      "description": "Every distinct client IP that has hit nginx in the visible time range, ranked by request count.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "topk(15, sum by (remote_addr) (count_over_time({job=\"nginx\"}[$__range])))", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "remote_addr": "Source IP", "Value": "Requests", "Value #A": "Requests" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Requests", "desc": true }] } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-BlPu" }, "custom": { "cellOptions": { "type": "gradient-gauge" } } }, "overrides": [] }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Suspicious: Top IPs by Failed/Rejected Requests",
      "description": "4xx/5xx responses grouped by source IP and path — a single IP hammering many different paths with 404s, or repeatedly hitting one path with 401/403/429, is what an intrusion attempt or scanner looks like here.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "topk(20, sum by (remote_addr, path, status) (count_over_time({job=\"nginx\", status=~\"4..|5..\"}[$__range])))", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "remote_addr": "Source IP", "path": "Path", "status": "Status", "Value": "Count", "Value #A": "Count" } } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }, { "color": "red", "value": 10 }] }, "custom": { "cellOptions": { "type": "color-background" } } }, "overrides": [{ "matcher": { "id": "byName", "options": "Status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }] }] }
    },

    {
      "id": 30,
      "type": "logs",
      "title": "Live Access Log — Failed / Suspicious Requests (4xx/5xx)",
      "description": "Raw log lines for anything nginx didn't answer with 2xx/3xx. Use the panel's own search box to filter by IP or path.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "{job=\"nginx\", status=~\"4..|5..\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    },

    {
      "id": 40,
      "type": "logs",
      "title": "Live Access Log — All Requests",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "codeveira-loki" },
      "targets": [
        { "expr": "{job=\"nginx\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
